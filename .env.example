# Meta WhatsApp Cloud API test credentials. Keep real values in .env only.
META_GRAPH_API_VERSION=v23.0
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Local PostgreSQL
POSTGRES_DB=whatsapp_ops
POSTGRES_USER=whatsapp_ops
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=jdbc:postgresql://localhost:5433/whatsapp_ops
DATABASE_USERNAME=whatsapp_ops
DATABASE_PASSWORD=local_dev_only

# Local web app
BACKEND_PORT=8081
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8081
# Local admin routes: set a long random value; copy the same value into
# BACKEND_ADMIN_API_KEY in frontend/.env.local. Never expose this as NEXT_PUBLIC_*.
DASHBOARD_ADMIN_API_KEY=

# AI providers. Keep real keys in .env only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
OCR_PROVIDER=openai
WHATSAPP_MEDIA_DIR=./data/media

# Operational metrics: an active pod is silent after this many hours without a message.
OPS_SILENCE_AFTER_HOURS=24
WEBHOOK_NORMALIZATION_DELAY_MS=500
WEBHOOK_NORMALIZATION_MAX_ATTEMPTS=5
